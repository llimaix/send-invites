# Referencia de las variables de deploy/.env. NO copiar a mano:
# el .env real se genera en el servidor con scripts/gen-secrets.sh.
# Ningún valor de este archivo es real.

DOMAIN=isdomana.com
ACME_EMAIL=tu-correo@ejemplo.com

# Origen permitido en Caddy para n8n y Evolution. TEMPORAL: cerrar a x.x.x.x/32.
ADMIN_CIDR=0.0.0.0/0

# Auth básica de Caddy delante de n8n y Evolution (hash bcrypt de `caddy hash-password`).
# Comillas simples: el hash lleva '$' y Compose no debe interpolarlo.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$reemplazar_por_hash_bcrypt'

POSTGRES_SUPERUSER_PASSWORD=generado
CHATWOOT_DB_PASSWORD=generado
EVOLUTION_DB_PASSWORD=generado
N8N_DB_PASSWORD=generado
REDIS_PASSWORD=generado

CHATWOOT_SECRET_KEY_BASE=generado
EVOLUTION_API_KEY=generado
N8N_ENCRYPTION_KEY=generado
